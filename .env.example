# Copiază acest fișier în `.env.local` și completează valorile.
# `.env.local` NU se urcă în git (vezi .gitignore).

# --- AI -------------------------------------------------------------------
# Cheia Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opțional: modelul folosit. Implicit: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# --- Origine canonică (link-uri de securitate) --------------------------
# Folosită EXCLUSIV pentru link-urile de verificare / resetare parolă.
# NU se citește niciodată din anteturi de cerere (anti host-header poisoning).
# În producție: setează valoarea reală în Vercel (Project → Settings →
# Environment Variables). Dacă lipsește, se folosește
# VERCEL_PROJECT_PRODUCTION_URL (setată automat de platformă).
APP_ORIGIN=
# Opțional, doar pentru dev local pe alt port:
DEV_APP_ORIGIN=http://localhost:3000

# --- E-mail (Resend) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=PflegeDoc <onboarding@resend.dev>

# --- Bază de date (injectată de integrarea Neon din Vercel) -----------
# DATABASE_URL=...

# --- Log de securitate ----------------------------------------------
# Sare pentru pseudonimizarea (HMAC) a IP-urilor în log-ul de securitate.
# Setează o valoare aleatoare lungă în Vercel. Nu e logată niciodată.
SECURITY_LOG_SALT=

# --- Testare engine (NU în producție) -----------------------------
# Header X-Engine-Test = această valoare ocolește autentificarea pe /api/generate.
# Bypass-ul e REFUZAT STRUCTURAL când NODE_ENV/VERCEL_ENV = "production",
# indiferent de această variabilă. A se seta DOAR pentru `vercel dev` local.
ENGINE_TEST_SECRET=
